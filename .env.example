# Binary Brain MCP — Environment Variables (optional)
# These can also be set in ~/.brain/config.json

# PostgreSQL (only if using postgres adapter)
# POSTGRES_CONNECTION_STRING=postgresql://user:pass@host:5432/brain

# Jina AI (only if using jina embedding)
# JINA_API_KEY=jina_xxxxxxxxxxxx

# OpenAI (only if using openai embedding)
# OPENAI_API_KEY=sk-xxxxxxxxxxxx

# HTTP Transport port (default: 3100)
# PORT=3100
